# Mandate — environment variables
#
# None of these are required. With no configuration the dashboard runs in
# local-demo mode: the real compiled circuits execute in your browser against an
# in-memory ledger. Set these to point the app at a deployed registry instead.
#
# Copy to .env.local for local development, or set them in the Vercel dashboard
# under Settings → Environment Variables.

# The Midnight network the connected wallet must be on. The app refuses to
# proceed if the wallet reports a different network, rather than silently
# transacting somewhere unexpected.
NEXT_PUBLIC_NETWORK_ID=preprod

# Address of a deployed Mandate registry. Leave unset to stay in local-demo mode.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# Note: there is deliberately no indexer or proof-server variable here.
# Indexer endpoints come from the wallet's own getConfiguration(), so a user
# pointed at a private indexer is not silently rerouted; and proving is
# delegated to the wallet, so this app hosts no proving service.
